---
import Base from '../layouts/Base.astro';
import Battle from '../components/Battle.astro';
import Ordinal from '../components/Ordinal.astro';
import Proof from '../components/Proof.astro';
import Model from '../components/Model.astro';
import Rules from '../components/Rules.astro';
import Glossary from '../components/Glossary.astro';

// フッターのリンク（ソースコードと作者のホームページ）
const REPO_URL = 'https://github.com/Alwe-logic/wormlab';
const AUTHOR_URL = 'https://alwe-logic.github.io/homepage/';

// ロゴの worm の頭（ドット絵、左向き）。1 文字が 1 ドット：
//   G 体、K 目、W 目の光、R 口、T 舌、. 透明
const HEAD = [
  '...GGGGGGGGG',
  '.GGGGGGGGGGG',
  '.GGWKKGGGGGG',
  'GGGKKKGGGGGG',
  'GGGKKKGGGGGG',
  'GGGGGGGGGGGG',
  'GRRRRRGGGGGG',
  'GGRTRGGGGGGG',
  'GGGGGGGGGGGG',
  '.GGGGGGGGGGG',
  '.GGGGGGGGGGG',
  '...GGGGGGGGG',
];
// しっぽの ⊤（太いドット）
const TAIL = ['GGGGGGGG', 'GGGGGGGG', ...Array(8).fill('...GG...')];
const PIXEL_COLOR: Record<string, string> = {
  G: 'var(--neon)',
  K: '#000',
  W: '#fff',
  R: 'var(--worm-mouth)',
  T: 'var(--worm-tongue)',
};
/** ドット絵の文字列を、色つきの 1×1 の四角の並びにする。 */
const pixels = (map: string[]) =>
  map.flatMap((row, y) => [...row].map((c, x) => ({ x, y, c }))).filter((p) => p.c !== '.');

const tabs = [
  { id: 'battle', label: 'battle', en: 'battle' },
  { id: 'ordinal', label: '順序数電卓', en: 'ordinals' },
  { id: 'proof', label: '証明', en: 'proofs' },
  { id: 'model', label: 'Kripke モデル', en: 'Kripke models' },
  // 推論規則（#rules）と定義（#defs）は 1 つのタブ。中で切り替える
  { id: 'rules', label: '規則と定義', en: 'rules & definitions' },
];
---

<Base title="wormlab">
  <header class="site">
    <div class="wrap">
      <div class="marquee">
        <!-- ロゴの worm は ⟨2⟩⟨0⟩⟨2⟩⊤（左が頭＝いちばん外側の文字）。頭を押すと battle が進む（lib/logo.ts） -->
        <span class="worm-logo">
          <button type="button" class="logo-poke" id="logo-head" aria-label="ロゴの worm の頭" data-en-aria-label="The head of the logo worm"
            ><svg class="seg head" viewBox="0 0 12 12" shape-rendering="crispEdges" aria-hidden="true">
              {pixels(HEAD).map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={PIXEL_COLOR[p.c]} />)}
            </svg></button
          ><span class="logo-body" id="logo-body" aria-hidden="true"
            ><span class="seg" style="animation-delay:-0.3s">2</span><span class="seg" style="animation-delay:-0.6s">0</span><span
              class="seg"
              style="animation-delay:-0.9s">2</span
            ></span
          ><button type="button" class="logo-poke" id="logo-tail" aria-label="ロゴの worm のしっぽ（⊤）" data-en-aria-label="The tail of the logo worm (⊤)"
            ><svg class="seg tail" viewBox="0 0 8 10" shape-rendering="crispEdges" aria-hidden="true" style="animation-delay:-1.2s">
              {pixels(TAIL).map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={PIXEL_COLOR[p.c]} />)}
            </svg></button
          >
        </span>
        <div class="title">
          <h1>WORMLAB</h1>
          <span class="sub" data-en="Computing Beklemishev's worms">Beklemishev の worm を計算する</span>
        </div>
        <button
          type="button"
          class="hiscore"
          id="hiscore"
          title="いちばん大きい記録。最初は RC_BI で届く Bachmann–Howard 順序数（BI の Π¹₁ 証明論的順序数）"
          data-en-title="The highest score. At first, the Bachmann–Howard ordinal reached by RC_BI (the Π¹₁ proof-theoretic ordinal of BI)"
        >
          <span class="label">HI-ORDINAL</span>
          <span class="value">ψ(ε<sub>Ω+1</sub>)</span>
        </button>
      </div>
      <!-- ロゴの worm の battle の様子（頭を押すまで出ない） -->
      <div class="logo-hud" id="logo-hud" aria-live="polite" hidden></div>
      <div class="navrow">
        <nav class="tabs" aria-label="道具" data-en-aria-label="Tools">
          {tabs.map((t) => <a href={`#${t.id}`} data-tab={t.id} data-en={t.en}>{t.label}</a>)}
        </nav>
        <!-- 言語の切り替え（選んだものは次に開いたときも使う） -->
        <div class="lang-switch" role="group" aria-label="言語 / Language">
          <button type="button" data-lang="ja" lang="ja" aria-pressed="false">JA</button>
          <button type="button" data-lang="en" lang="en" aria-pressed="false">EN</button>
        </div>
      </div>
    </div>
    <div class="wrap"><div class="pellets" aria-hidden="true"></div></div>
  </header>
  <main class="wrap">
    <Battle />
    <Ordinal />
    <Proof />
    <Rules />
    <Model />
    <Glossary />
  </main>
  <footer>
    <div class="wrap">
      <div class="pellets" aria-hidden="true"></div>
      <!-- #version は読み込んだあとに書き込むので、言語で入れ替える文の外に置く -->
      <span data-en="All computation happens in this browser, by wormlab-core written in Rust (WebAssembly build"
        >計算はすべてこのブラウザの中で、Rust で書いた wormlab-core（WebAssembly 版</span
      > <span id="version">…</span><span data-en=").">）が行います。</span>
      <span
        data-en="References: Beklemishev (RC), de Almeida Borges–Joosten (WC), Fernández-Duque–Hermo Reyes (bracket words, BC), Pakhomov–Lazar (RC_BI, arXiv:2610.20115)."
        >参考文献：Beklemishev（RC）、de Almeida Borges–Joosten（WC）、Fernández-Duque–Hermo Reyes（括弧語・BC）、
        Pakhomov–Lazar（RC_BI, arXiv:2610.20115）。</span
      >
      <span
        data-en-html={`Source code: <a href="${REPO_URL}">GitHub</a> (MIT / Apache-2.0). Author: <a href="${AUTHOR_URL}en/about/">Ichikawa Koshiro</a>.`}
        >ソースコード：<a href={REPO_URL}>GitHub</a>（MIT / Apache-2.0）。作者：<a href={`${AUTHOR_URL}about/`}
          >Ichikawa Koshiro</a
        >。</span
      >
      <div class="credit">EVERY WORM REACHES ⊤ — BUT PA CAN'T PROVE IT</div>
    </div>
  </footer>
  <!-- HI-ORDINAL のハイスコア表（lib/hiscore.ts が中身を作る） -->
  <dialog class="hiscore-dialog" id="hiscore-dialog" aria-label="HIGH SCORES"></dialog>
</Base>

<script>
  import { wasm } from '../lib/wasm';
  import { applyStatic, lang, setLang, tr, type Lang } from '../lib/i18n';
  import { setupLogo } from '../lib/logo';
  import { setupHiscore } from '../lib/hiscore';
  import { setupConsole } from '../lib/devconsole';

  // 静的な文を今の言語にする（英語なら、Base の小さなスクリプトが隠していた画面をここで出す）
  applyStatic();

  // 言語の切り替えボタン
  const langButtons = document.querySelectorAll<HTMLButtonElement>('.lang-switch button');
  function markLang() {
    langButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === lang())));
  }
  langButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const l = b.dataset.lang as Lang;
      if (l !== lang()) setLang(l);
      markLang();
    }),
  );
  markLang();

  // タブの切り替え（URL の #battle などで選ぶ）
  /** 狭い画面ではタブの列が横にスクロールするので、選んだタブが隠れていれば列の中央に寄せる（ページは動かさない） */
  function showInBar(a: HTMLElement) {
    const bar = a.parentElement;
    if (!bar) return;
    const r = a.getBoundingClientRect();
    const b = bar.getBoundingClientRect();
    if (r.left < b.left || r.right > b.right) bar.scrollLeft += r.left - b.left - (b.width - r.width) / 2;
  }

  /** 1 つのタブの中で切り替える画面（推論規則 #rules と定義 #defs は「規則と定義」のタブ） */
  const TAB_OF: Record<string, string> = { defs: 'rules' };
  function select() {
    const id = location.hash.slice(1) || 'battle';
    const tab = TAB_OF[id] ?? id;
    document.querySelectorAll<HTMLElement>('section.panel').forEach((p) => {
      p.classList.toggle('active', p.dataset.panel === id);
    });
    document.querySelectorAll<HTMLAnchorElement>('nav.tabs a').forEach((a) => {
      if (a.dataset.tab === tab) {
        a.setAttribute('aria-current', 'page');
        // タブを押し直したときは、最後に見ていた側（推論規則か定義）を開く
        a.setAttribute('href', `#${id}`);
        showInBar(a);
      } else a.removeAttribute('aria-current');
    });
    // 「規則と定義」の中の切り替え（Rules.astro・Glossary.astro の nav.subtabs）
    document.querySelectorAll<HTMLAnchorElement>('nav.subtabs a').forEach((a) => {
      if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  window.addEventListener('hashchange', select);
  select();
  setupLogo();

  // WebAssembly を先に読み込んでおき、版を表示する
  wasm()
    .then((api) => {
      const v = document.getElementById('version');
      if (v) v.textContent = api.version();
      // 隠し機能（ロゴの worm、ハイスコア表、コンソールの一言）
      setupHiscore();
      setupConsole();
    })
    .catch((e) => {
      const v = document.getElementById('version');
      const msg = e instanceof Error ? e.message : String(e);
      if (v) v.textContent = tr(`（読み込めません：${msg}）`, `(could not load: ${msg})`);
    });
</script>
