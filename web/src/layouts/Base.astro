---
// ページ全体の枠：見出し・タブ・フッター。
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#000000" />
    <!-- ドットのフォント：Press Start 2P（英字）と DotGothic16（日本語） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap" rel="stylesheet" />
    <meta name="description" content="Beklemishev の worm、反射計算（RC・WC・BC・RC_BI）、順序数をブラウザで計算する" />
  </head>
  <body>
    <slot />
  </body>
</html>
