---
// ページ全体の枠：見出し・タブ・フッター。
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#000000" />
    <!-- ドットのフォント：Press Start 2P（英字）と DotGothic16（日本語） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap" rel="stylesheet" />
    <meta name="description" content="Beklemishev の worm、反映計算（RC・WC・BC・RC_BI）、順序数をブラウザで計算する" />
    <!--
      言語の先読み（lib/i18n.ts の detect と同じ決め方）。英語で表示するときは、日本語の文が一瞬
      見えないように、applyStatic が入れ替えるまで画面を隠す（スクリプトが動かなくても 2 秒で出す）。
    -->
    <script is:inline>
      (function () {
        var l = null;
        try {
          l = localStorage.getItem('wormlab-lang');
        } catch (e) {}
        if (l !== 'ja' && l !== 'en') {
          var ls = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          l = ls.some(function (x) {
            return x && x.toLowerCase().indexOf('ja') === 0;
          })
            ? 'ja'
            : 'en';
        }
        if (l === 'en') {
          var root = document.documentElement;
          root.lang = 'en';
          root.classList.add('i18n-pending');
          setTimeout(function () {
            root.classList.remove('i18n-pending');
          }, 2000);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
