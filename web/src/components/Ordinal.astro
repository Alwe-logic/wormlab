---
// 順序数電卓：順序数・worm・括弧語を相互に変換し、基本列や大小を調べる。
// いちばん上で、このタブに出る数をどの標準形で書くかを選ぶ（NotationPicker.astro・lib/notation.ts）。
// その下に、基本列をたどる探検（Explore.astro）、演算（Arith.astro）、式の標準形（Expr.astro）、大小の比較、
// RC_BI の式の比較と基本列。
import Arith from './Arith.astro';
import Explore from './Explore.astro';
import Expr from './Expr.astro';
import NotationPicker from './NotationPicker.astro';

// 英語の文（中に要素があるものは data-en-html に入れる）
const EN = {
  lead:
    "Rewrites ordinals in Veblen notation, as worms (with ordinal letters) and as bracket words. Whichever form you enter, you get the normal form of the same ordinal. Numbers beyond Γ₀ can be written with Ω and the collapsing function ψ of Worms and spiders, as in <span class='mono'>ψ(ε_(Ω + 1))</span>, or as impredicative worms with Ω as a letter, as in <span class='mono'>((()))Ω</span>. Wherever an ordinal is asked for (worm letters included), you can also type an expression such as <span class='mono'>ψ(Ω^Ω)</span>, <span class='mono'>ε_0·ω</span> or <span class='mono'>(ω + 1)^2</span>; it is computed to normal form, with the same syntax as the expression card below.",
  rcbi:
    "A &lt;¹₁ B means “B ⊢ ⟨1⟩₁A”. Closed formulas without ∇ are well-ordered by this order and reach up to the Bachmann–Howard ordinal. Syntax: <span class='mono'>&lt;1&gt;_2</span> = ⟨1⟩₂, <span class='mono'>&lt;2&gt;_3</span> = ⟨2⟩₃, <span class='mono'>D</span> = ↓, <span class='mono'>T</span> = ⊤.",
};
---

<section class="panel" data-panel="ordinal">
  <p class="lead" data-en-html={EN.lead}>
    順序数を、Veblen 表記・worm（文字が順序数）・括弧語で書き換えます。どの書き方で入れても、同じ順序数の標準形が出ます。Γ₀ を超える数は、Ω と Worms and spiders の崩壊関数 ψ を使って <span class="mono">ψ(ε_(Ω + 1))</span> のように書くか、Ω を文字に持つ impredicative worm で <span class="mono">((()))Ω</span> のように書けます。順序数を入れる欄（worm の文字も）には、<span class="mono">ψ(Ω^Ω)</span>・<span class="mono">ε_0·ω</span>・<span class="mono">(ω + 1)^2</span> のような式も書けます（下の「式の標準形」のカードと同じ書き方で、計算して標準形にします）。
  </p>
  <NotationPicker />
  <div class="card">
    <h2 data-en="Conversion and fundamental sequences">変換と基本列</h2>
    <div class="controls">
      <select id="o-kind" aria-label="入力の種類" data-en-aria-label="Input kind">
        <option value="ordinal" data-en="ordinal">順序数</option>
        <option value="worm">worm</option>
        <option value="bracket" data-en="bracket word">括弧語</option>
        <option value="iworm">impredicative worm</option>
      </select>
      <input type="text" id="o-input" value="ε_0" aria-label="入力" data-en-aria-label="Input" />
      <button class="primary" id="o-run" type="button" data-en="Compute">計算</button>
    </div>
    <div class="examples" id="o-examples"></div>
    <div class="def-links">
      <span data-en="Definitions:">定義：</span>
      <button type="button" class="small" data-def="worm-o">o(A)</button>
      <button type="button" class="small" data-def="worm-o-transfinite" data-en="o(A) (ordinal letters)">o(A)（文字が順序数）</button>
      <button type="button" class="small" data-def="worm-inverse" data-en="normal-form worm">標準形の worm</button>
      <button type="button" class="small" data-def="bracket">o*(a)</button>
      <button type="button" class="small" data-def="iworm">p(w)</button>
      <button type="button" class="small" data-def="fs">α[n]</button>
      <button type="button" class="small" data-def="worm-fs">α&#123;n&#125;</button>
      <button type="button" class="small" data-def="hardy">H_α</button>
      <button type="button" class="small" data-def="normal" data-en="normal form">標準形</button>
    </div>
    <div class="status" id="o-status" aria-live="polite"></div>
    <table class="kv" id="o-table" hidden></table>
    <div id="o-tex"></div>
  </div>

  <Explore />
  <Arith />
  <Expr />

  <div class="card">
    <h2 data-en="Comparison">大小の比較</h2>
    <div class="controls">
      <select id="c-kind-a" aria-label="左の種類" data-en-aria-label="Left kind">
        <option value="ordinal" data-en="ordinal">順序数</option><option value="worm" selected>worm</option><option value="bracket" data-en="bracket word">括弧語</option><option value="iworm">impredicative worm</option>
      </select>
      <input type="text" id="c-a" value="1 1" aria-label="左" data-en-aria-label="Left" />
      <select id="c-kind-b" aria-label="右の種類" data-en-aria-label="Right kind">
        <option value="ordinal" data-en="ordinal">順序数</option><option value="worm">worm</option><option value="bracket" data-en="bracket word">括弧語</option><option value="iworm">impredicative worm</option>
      </select>
      <input type="text" id="c-b" value="ω^2" aria-label="右" data-en-aria-label="Right" />
      <button class="primary" id="c-run" type="button" data-en="Compare">比較</button>
    </div>
    <div class="examples" id="c-examples"></div>
    <div class="def-links">
      <span data-en="Definitions:">定義：</span>
      <button type="button" class="small" data-def="worm" data-en="the worm order <₀">worm の順序 <₀</button>
      <button type="button" class="small" data-def="normal" data-en="normal form">標準形</button>
    </div>
    <div class="verdict" id="c-out"></div>
    <div id="c-tex"></div>
  </div>

  <div class="card">
    <h2 data-en="RC_BI formulas (Pakhomov–Lazar): the order <¹₁ and fundamental sequences">
      RC_BI の式（Pakhomov–Lazar）：順序 &lt;¹₁ と基本列
    </h2>
    <p class="muted" style="margin:0 0 8px;font-size:13px" data-en-html={EN.rcbi}>
      A &lt;¹₁ B は「B ⊢ ⟨1⟩₁A」。∇ を含まない閉じた式はこの順序で整列し、Bachmann–Howard 順序数までを表します。
      書き方：<span class="mono">&lt;1&gt;_2</span> = ⟨1⟩₂、<span class="mono">&lt;2&gt;_3</span> = ⟨2⟩₃、
      <span class="mono">D</span> = ↓、<span class="mono">T</span> = ⊤。
    </p>
    <div class="controls">
      <input type="text" id="r-a" value="<1>_3<2>_3 T" aria-label="式 A" data-en-aria-label="Formula A" />
      <input type="text" id="r-b" value="<2>_2<2>_3 T" aria-label="式 B" data-en-aria-label="Formula B" />
      <button class="primary" id="r-cmp" type="button" data-en="Compare">比較</button>
    </div>
    <div class="examples" id="r-examples"></div>
    <div class="def-links">
      <span data-en="Definitions:">定義：</span>
      <button type="button" class="small" data-def="rcbi-order" data-en="<¹₁ and ordinals"><¹₁ と順序数</button>
      <button type="button" class="small" data-def="rcbi-fs" data-en="forms and (A)_n">形と近似 (A)_n</button>
    </div>
    <div class="verdict" id="r-out"></div>
    <div id="r-tex"></div>
    <div class="controls" style="margin-top:10px">
      <input type="text" id="r-f" value="<2>_2<2>_3 T" aria-label="基本列を見る式" data-en-aria-label="Formula to inspect" />
      <button id="r-fs" type="button" data-en="Form and fundamental sequence">形と基本列</button>
    </div>
    <div class="examples" id="r-f-examples"></div>
    <div class="status" id="r-status" aria-live="polite"></div>
    <div id="r-info"></div>
  </div>
</section>

<script>
  import { call, nextFrame } from '../lib/wasm';
  import { busyText, byId, exampleButtons, examples, exploreOrdinal, h, setStatus } from '../lib/dom';
  import { recordOrdinal } from '../lib/hiscore';
  import { onLang, tr } from '../lib/i18n';
  import { texBlock } from '../lib/latex';
  import { fallbackLine, notation, notationName, onNotation, prepare, show, shownEl } from '../lib/notation';

  interface Info {
    input: {
      kind: string;
      text: string;
      normal_form?: string;
      is_normal?: boolean;
      depth?: number;
      worm?: string;
      /** impredicative worm の o(w^π) */
      ordinal?: string;
    };
    ordinal: string;
    is_zero: boolean;
    is_limit: boolean;
    is_successor: boolean;
    below_epsilon0: boolean;
    worm: string;
    worm_finite: string | null;
    /** Γ0 以上（Ω・ψ を含む数）では null */
    bracket: string | null;
    bracket_depth: number | null;
    predicative: boolean;
    /** 値がこの数になる impredicative worm（ψ(e_{Ω+1}1) 未満の可算な数だけ） */
    iworm: string | null;
    countable: boolean;
    fundamental: string[];
    worm_fundamental: string[];
    hardy: { n: string; value: string | null }[];
    /** 書き換え・基本列・Hardy 関数をまとめた align* */
    latex: string;
  }

  // 最初の 6 個が見えていて、残りは「もっと」で開く
  const EXAMPLES: Record<string, string[]> = {
    ordinal: [
      'ε_0', 'ω^ω + 3', 'ε_1', 'ε_0·ω', 'φ(2, 0)', 'ψ(0)', 'φ(ω, 0)', 'φ(ε_0, 0)', 'ψ(Ω)', 'ψ(Ω^Ω)', 'ψ(ε_(Ω + 1))',
      'ω^2 + ω·3 + 1', 'ω^(ω + 1)', 'ε_ω', 'ε_(ε_0)', 'φ(2, 1)', 'φ(3, 0)', 'φ(ω^ω, 0)', 'ψ(1)', 'ψ(Ω·2)', 'e^(ω^2)(1)',
    ],
    worm: ['2 0 1', '1 1 1', '<ω><ω>', '<ε_0 + 1><0>', '<Ω^Ω>', '1 0 1', '2 1 0', '3', '0 0 0', '<ω^2>', '<ω + 1><0><ω>', '<φ(2, 0)>'],
    bracket: ['((()))', '(())()', '((())(()))', '(((())))', '()()', '(()())', '(()())()(())', '((())())', '(()(()))'],
    iworm: ['Ω', '()Ω', 'Ω()Ω', '((()))Ω', '(Ω)Ω', 'ΩΩ', '(())Ω', '(Ω)', 'ΩΩΩ', '((Ω))Ω'],
  };

  /** 比較のカードの例：左の種類・左・右の種類・右 */
  const COMPARE_EXAMPLES: [string, string, string, string][] = [
    ['worm', '1 1', 'ordinal', 'ω^2'],
    ['worm', '2 0 1', 'worm', '2'],
    ['bracket', '((()))', 'ordinal', 'ε_0'],
    ['ordinal', 'ε_0·2', 'ordinal', 'ω^(ε_0 + 1)'],
    ['iworm', 'Ω', 'ordinal', 'ψ(0)'],
    ['worm', '1 0 1 1', 'worm', '1 1'],
    ['ordinal', 'φ(ω, 0)', 'bracket', '(((())))'],
    ['ordinal', 'Ω^Ω', 'ordinal', 'Ω·ω'],
    ['bracket', '(())()', 'bracket', '(())'],
    ['ordinal', 'ψ(Ω)', 'iworm', 'Ω()Ω'],
  ];

  /** RC_BI のカードの例：比べる 2 つの式と、形と基本列を見る式 */
  const RCBI_PAIRS: [string, string][] = [
    ['<1>_3<2>_3 T', '<2>_2<2>_3 T'],
    ['<1>_2 T', 'D T'],
    ['<1>_1 T & <1>_1 T', '<1>_1 T'],
    ['<2>_2 T', 'D D T'],
    ['D <1>_2 T', '<2>_2 T'],
    ['<1>_1 <1>_1 T', '<1>_2 T'],
    ['<2>_3 T', '<2>_2 <2>_2 T'],
  ];
  const RCBI_FORMS = ['<2>_2<2>_3 T', '<1>_2 T', 'D T', '<2>_2 T', 'D <1>_2 T', '<1>_2 T & <1>_1 <1>_1 T', '<1>_1 <1>_1 T & <1>_1 T', 'T & T'];

  const kind = byId<HTMLSelectElement>('o-kind');
  const input = byId<HTMLInputElement>('o-input');
  const status = byId('o-status');
  const table = byId<HTMLTableElement>('o-table');

  function row(label: string, value: Node | string) {
    return h('tr', {}, h('th', {}, label), h('td', {}, value));
  }

  /** 数の列（今の標準形で。書けない数があれば、その理由を下に） */
  function seq(items: string[]) {
    return h(
      'div',
      {},
      h('ol', { class: 'seq', start: '0' }, ...items.map((x) => h('li', {}, shownEl(x)))),
      fallbackLine(items),
    );
  }

  /** 実行したことのある計算（言語を切り替えたら、その言語で出し直す） */
  const shown = new Set<() => void>();

  async function run() {
    shown.add(run);
    setStatus(status, busyText());
    await nextFrame();
    try {
      const r = await call<Info>((api) => api.ordinal_info(kind.value, input.value));
      setStatus(status, '');
      recordOrdinal(r.ordinal, 'calc');
      const rows = [row(tr('入力', 'Input'), r.input.text)];
      if (r.input.kind === 'worm' && r.input.normal_form) {
        rows.push(row(tr('入力の標準形', 'Normal form of the input'), r.input.normal_form));
      }
      if (r.input.kind === 'bracket') {
        rows.push(row(tr('翻訳 a*', 'Translation a*'), r.input.worm ?? ''));
        rows.push(
          row(
            tr('入力の正規形', 'Normal form of the input'),
            `${r.input.normal_form}${r.input.is_normal ? tr('（この語自身が正規形）', ' (the word itself is in normal form)') : ''}`,
          ),
        );
      }
      if (r.input.kind === 'iworm') {
        rows.push(row(tr('翻訳 w^π', 'Translation w^π'), r.input.worm ?? ''));
        rows.push(
          row(
            'o(w^π)',
            `${r.input.ordinal}${tr(
              '（値 p(w) は、可算ならこれ、Ω 以上なら ψ(−Ω + o(w^π))）',
              ' (the value p(w) is this if countable, and ψ(−Ω + o(w^π)) if ≥ Ω)',
            )}`,
          ),
        );
      }
      // 順序数：選んだ標準形で（Veblen 形以外を選んでいれば、Veblen 形も並べる）
      prepare([r.ordinal, ...r.fundamental, ...r.worm_fundamental]);
      if (notation() === 'veblen') {
        rows.push(row(tr('順序数', 'Ordinal'), r.ordinal));
      } else {
        rows.push(
          row(
            tr(`順序数（${notationName()}）`, `Ordinal (${notationName()})`),
            h('div', {}, shownEl(r.ordinal, 'div', 'step-text'), fallbackLine([r.ordinal])),
          ),
        );
        rows.push(row(tr('順序数（Veblen 形）', 'Ordinal (Veblen form)'), r.ordinal));
      }
      rows.push(
        row(
          tr('種類', 'Kind'),
          r.is_zero ? '0' : r.is_limit ? tr('極限順序数', 'limit ordinal') : tr('後続順序数', 'successor ordinal'),
        ),
      );
      if (r.worm_finite) rows.push(row(tr('worm（自然数の文字）', 'worm (natural-number letters)'), r.worm_finite || '⊤'));
      rows.push(row(tr('worm（順序数の文字）', 'worm (ordinal letters)'), r.worm || '⊤'));
      if (r.iworm !== null && r.input.kind !== 'iworm') rows.push(row('impredicative worm', r.iworm || '⊤'));
      if (r.input.kind === 'iworm' && r.iworm !== r.input.text) {
        rows.push(row(tr('impredicative worm の標準形', 'impredicative worm (normal form)'), r.iworm || '⊤'));
      }
      if (r.bracket !== null) {
        rows.push(
          row(
            tr('括弧語（正規形）', 'bracket word (normal form)'),
            tr(`${r.bracket}　（入れ子の深さ ${r.bracket_depth}）`, `${r.bracket}  (nesting depth ${r.bracket_depth})`),
          ),
        );
      } else {
        const c = r.countable ? tr('可算', 'countable') : tr('非可算', 'uncountable');
        rows.push(
          row(
            tr('括弧語', 'bracket word'),
            tr(`Γ₀ 以上なので括弧語では表せない（${c}）`, `cannot be written as a bracket word, since it is ≥ Γ₀ (${c})`),
          ),
        );
      }
      if (r.fundamental.length) {
        // 基本列の探検（下のカード）に、この数から始めてもらう
        const more = h('button', { type: 'button', class: 'small' }, tr('この数の基本列をたどる ↓', 'Explore its fundamental sequences ↓'));
        more.addEventListener('click', () => exploreOrdinal(r.ordinal));
        rows.push(row(tr('標準の基本列 α[0..5]', 'Standard fundamental sequence α[0..5]'), h('div', {}, seq(r.fundamental), more)));
      }
      if (r.worm_fundamental.length) {
        rows.push(row(tr('worm が作る列 α{0..5}', 'Sequence given by the worm α{0..5}'), seq(r.worm_fundamental)));
      }
      if (r.hardy.length) {
        rows.push(
          row(
            tr('Hardy 関数', 'Hardy function'),
            h(
              'div',
              {},
              ...r.hardy.map((x) => {
                // 値は多倍長：ちょうどの値（60 桁を超えたら 1.23×10^k の形）か「2^k を超える」などの下界。
                // 下界の文は日本語なら「… 以上」、英語なら "at least …" や "greater than …"（数字で始まらない）
                const v = x.value ?? tr('計算できない', 'cannot be computed');
                const exact = /^[0-9]/.test(v) && !v.includes('以上');
                return h('div', {}, exact ? `H_α(${x.n}) = ${v}` : `H_α(${x.n})${tr('：', ': ')}${v}`);
              }),
            ),
          ),
        );
      }
      table.replaceChildren(...rows);
      table.hidden = false;
      byId('o-tex').replaceChildren(
        texBlock({
          title: tr('LaTeX（書き換え・基本列・Hardy 関数）', 'LaTeX (rewritings, fundamental sequences, Hardy function)'),
          code: r.latex,
          note: tr(
            '\\begin{align*} は amsmath。worm は ⟨α⟩…⊤、括弧語の順序数は o^*(a) と書いています。',
            '\\begin{align*} needs amsmath. Worms are written ⟨α⟩…⊤, and the ordinal of a bracket word as o^*(a).',
          ),
        }).el,
      );
    } catch (e) {
      setStatus(status, e instanceof Error ? e.message : String(e), true);
      table.hidden = true;
      byId('o-tex').replaceChildren();
    }
  }

  function fillExamples() {
    examples(byId('o-examples'), input, EXAMPLES[kind.value], run);
    // 比較のカード：種類も一緒に入れる
    exampleButtons(
      byId('c-examples'),
      COMPARE_EXAMPLES.map(([ka, a, kb, b]) => ({
        label: `${a}  vs  ${b}`,
        run: () => {
          byId<HTMLSelectElement>('c-kind-a').value = ka;
          byId<HTMLInputElement>('c-a').value = a;
          byId<HTMLSelectElement>('c-kind-b').value = kb;
          byId<HTMLInputElement>('c-b').value = b;
          compare();
        },
      })),
    );
    // RC_BI のカード：比べる 2 つの式と、形と基本列を見る式
    exampleButtons(
      byId('r-examples'),
      RCBI_PAIRS.map(([a, b]) => ({
        label: `${a}  vs  ${b}`,
        run: () => {
          byId<HTMLInputElement>('r-a').value = a;
          byId<HTMLInputElement>('r-b').value = b;
          rcbiCompare();
        },
      })),
    );
    examples(byId('r-f-examples'), byId<HTMLInputElement>('r-f'), RCBI_FORMS, () => rcbiInfo());
  }

  kind.addEventListener('change', () => {
    input.value = EXAMPLES[kind.value][0];
    fillExamples();
  });
  byId('o-run').addEventListener('click', run);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') run();
  });
  fillExamples();

  // 比較
  async function compare() {
    shown.add(compare);
    const out = byId('c-out');
    try {
      const r = await call<{ a: string; b: string; relation: string; latex: string }>((api) =>
        api.ordinal_compare(
          byId<HTMLSelectElement>('c-kind-a').value,
          byId<HTMLInputElement>('c-a').value,
          byId<HTMLSelectElement>('c-kind-b').value,
          byId<HTMLInputElement>('c-b').value,
        ),
      );
      prepare([r.a, r.b]);
      out.replaceChildren(`${show(r.a)}  ${r.relation}  ${show(r.b)}`);
      const note = fallbackLine([r.a, r.b]);
      if (note) out.append(note);
      byId('c-tex').replaceChildren(texBlock({ title: 'LaTeX', code: r.latex }).el);
    } catch (e) {
      out.textContent = e instanceof Error ? e.message : String(e);
      byId('c-tex').replaceChildren();
    }
  }
  byId('c-run').addEventListener('click', compare);

  // RC_BI
  async function rcbiCompare() {
    shown.add(rcbiCompare);
    const out = byId('r-out');
    out.textContent = busyText();
    await nextFrame();
    try {
      const r = await call<{ a: string; b: string; relation: string | null; latex: string | null }>((api) =>
        api.rcbi_compare(byId<HTMLInputElement>('r-a').value, byId<HTMLInputElement>('r-b').value),
      );
      const rel = r.relation
        ? `${r.relation}¹₁`
        : tr('?（比較できない：Thm 4.11 に反する）', '? (incomparable: this contradicts Thm 4.11)');
      out.textContent = `${r.a}  ${rel}  ${r.b}`;
      byId('r-tex').replaceChildren(r.latex ? texBlock({ title: 'LaTeX', code: r.latex }).el : '');
    } catch (e) {
      out.textContent = e instanceof Error ? e.message : String(e);
      byId('r-tex').replaceChildren();
    }
  }
  byId('r-cmp').addEventListener('click', rcbiCompare);

  async function rcbiInfo() {
    shown.add(rcbiInfo);
    const st = byId('r-status');
    const box = byId('r-info');
    setStatus(st, busyText());
    await nextFrame();
    try {
      const r = await call<{
        formula: string;
        form: string;
        predecessor: string | null;
        approximations: string[];
        latex: string;
      }>((api) => api.rcbi_info(byId<HTMLInputElement>('r-f').value, 5));
      setStatus(st, '');
      const form =
        r.form === 'zero'
          ? tr('零（⊤ と ≡¹₁）', 'zero (≡¹₁ ⊤)')
          : r.form === 'successor'
            ? tr('後続形', 'successor form')
            : tr('極限形', 'limit form');
      const rows = [row(tr('式', 'Formula'), r.formula), row(tr('形', 'Form'), form)];
      if (r.predecessor) rows.push(row(tr('直前', 'Predecessor'), r.predecessor));
      if (r.approximations.length) {
        rows.push(
          row(
            tr('基本列 (A)_1..5', 'Fundamental sequence (A)_1..5'),
            h('ol', { class: 'seq' }, ...r.approximations.map((x) => h('li', {}, x))),
          ),
        );
      }
      box.replaceChildren(
        h('table', { class: 'kv' }, ...rows),
        texBlock({ title: tr('LaTeX（形と基本列）', 'LaTeX (form and fundamental sequence)'), code: r.latex }).el,
      );
    } catch (e) {
      setStatus(st, e instanceof Error ? e.message : String(e), true);
      box.replaceChildren();
    }
  }
  byId('r-fs').addEventListener('click', rcbiInfo);

  // 言語の切り替え：例を並べ直し、出している結果をその言語で出し直す
  onLang(() => {
    fillExamples();
    for (const f of shown) f();
  });
  // 標準形の切り替え：順序数を出している結果（変換・比較）を出し直す
  onNotation(() => {
    if (shown.has(run)) run();
    if (shown.has(compare)) compare();
  });
</script>
