---
// 証明の表示：RC・WC・BC で判定し、成り立てば導出を木で、成り立たなければ反例モデルを出す。
---

<section class="panel" data-panel="proof">
  <p class="lead">
    シーケント A ⊢ B を判定し、成り立てば導出を作って検査してから表示します（検査器は導出を 1 ステップずつ
    規則に照らすだけなので、表示された導出は正しいと保証されます）。成り立たなければ反例のモデルを表示します。
    証明は LaTeX（bussproofs の証明木と行番号つきの一覧）、モデルは TikZ のコードでも出します。
  </p>
  <div class="card">
    <div class="controls">
      <select id="p-system" aria-label="体系">
        <option value="rc">RC（Reflection Calculus）</option>
        <option value="wc">WC（Worm Calculus、worm だけ）</option>
        <option value="bc">BC（Bracket Calculus）</option>
        <option value="rcbi">RC_BI（判定とモデルだけ）</option>
      </select>
      <input type="text" id="p-input" value="<1>p & <0>q |- <1>(p & <0>q)" aria-label="シーケント" />
      <button class="primary" id="p-run" type="button">判定</button>
    </div>
    <div class="examples" id="p-examples"></div>
    <div class="status" id="p-status" aria-live="polite"></div>
  </div>
  <div class="card" id="p-result" hidden>
    <div class="verdict" id="p-verdict"></div>
    <div class="muted" id="p-extra" style="font-size:13px;margin-bottom:8px"></div>
    <div id="p-body"></div>
    <div id="p-tex"></div>
  </div>
</section>

<script>
  import { call, nextFrame } from '../lib/wasm';
  import { byId, h, setStatus } from '../lib/dom';
  import { renderProof, type ProofJson } from '../lib/proof';
  import { renderModel, type ModelJson } from '../lib/graph';
  import { texBlock } from '../lib/latex';

  interface ProveJson {
    holds: boolean;
    sequent: string;
    proof?: ProofJson;
    model?: ModelJson;
    tau?: string;
    stats?: Record<string, number>;
    /** シーケント（⊢ か ⊬）の LaTeX */
    latex: string;
  }

  const EXAMPLES: Record<string, string[]> = {
    rc: ['<1>p & <0>q |- <1>(p & <0>q)', '<2>p |- <0><1>p', '<ω+1>p & <ω>q |- <ω+1>(p & <ω>q)', '<0>p |- <1>p'],
    wc: ['1 1 |- 0 1 0 1', '2 0 1 |- 1 0 1', '<ω><ω> |- <0><ω><0>', '1 |- 2'],
    bc: ['((()))p |- ()(())p', '((((())))) |- ()(((())))', '((())())p |- ((()))p', '()p |- (())p'],
    rcbi: ['<2>_2 T |- <1> D T', '<2>_2<2>_3 T |- <1>(<1>_3<2>_3 T)', 'D T |- <2>_2 T'],
  };
  const NOTES: Record<string, string> = {
    rc: '書き方：<1>p & <0>q |- <1>(p & <0>q)。モダリティは自然数か順序数（<ω+1>、<ε_0>）。',
    wc: '書き方：worm どうしのシーケント "1 1 |- 0 1 0 1"。文字が順序数なら <ω><0>。',
    bc: '書き方：(a)φ（a は括弧語）。((()))p = ⟨ω⟩p。括弧語はそのまま式として読む。',
    rcbi: '書き方：<1>_2 = ⟨1⟩₂、<2>_3 = ⟨2⟩₃、D = ↓、N = ∇、T = ⊤。変数のない式だけ。',
  };

  const system = byId<HTMLSelectElement>('p-system');
  const input = byId<HTMLInputElement>('p-input');
  const status = byId('p-status');

  function fillExamples() {
    const box = byId('p-examples');
    box.replaceChildren(h('span', {}, '例：'));
    for (const x of EXAMPLES[system.value]) {
      const b = h('button', { type: 'button' }, x);
      b.addEventListener('click', () => {
        input.value = x;
        run();
      });
      box.append(b);
    }
    box.append(h('span', { style: 'flex-basis:100%' }, NOTES[system.value]));
  }

  async function run() {
    setStatus(status, '計算中…');
    await nextFrame();
    try {
      const r = await call<ProveJson>((api) => api.prove(system.value, input.value));
      setStatus(status, '');
      const name = { rc: 'RC', wc: 'WC', bc: 'BC', rcbi: 'RC_BIω' }[system.value] ?? system.value;
      const v = byId('p-verdict');
      v.replaceChildren(
        h('span', { class: r.holds ? 'yes' : 'no' }, r.holds ? `${name} で導出できる：` : `${name} では導出できない：`),
        r.sequent,
      );
      const extra: string[] = [];
      if (r.tau) extra.push(`τ で RC_Γ0 に翻訳：${r.tau}`);
      if (r.stats?.side_conditions !== undefined) {
        extra.push(`副条件（括弧語どうしの比較）の導出 ${r.stats.side_conditions} 個、入れ子は最大 ${r.stats.max_side_depth} 段`);
      }
      if (r.stats?.facts_used !== undefined) {
        extra.push(`書き足した事実 ${r.stats.facts_used} 個 / 飽和で得た事実 ${r.stats.facts_total} 個`);
      }
      if (r.proof) extra.push('導出は検査済み');
      byId('p-extra').textContent = extra.join('　');
      byId('p-tex').replaceChildren(texBlock({ title: 'シーケント（LaTeX）', code: r.latex }).el);
      const body = byId('p-body');
      if (r.proof) {
        renderProof(body, r.proof);
      } else if (r.model) {
        const title = r.holds
          ? '左辺の有限モデル M_A（根 0 で右辺が真）'
          : '反例：左辺のモデルの根 0 で右辺が偽（右辺が真の点を太い輪で示す）';
        body.replaceChildren(h('p', { style: 'margin:0 0 6px' }, title));
        const g = h('div');
        body.append(g);
        renderModel(g, r.model, '右辺が真');
      } else {
        body.replaceChildren(h('p', { class: 'muted' }, '（WC は worm だけの体系なので、反例モデルは出しません）'));
      }
      byId('p-result').hidden = false;
    } catch (e) {
      setStatus(status, e instanceof Error ? e.message : String(e), true);
    }
  }

  system.addEventListener('change', () => {
    input.value = EXAMPLES[system.value][0];
    fillExamples();
  });
  byId('p-run').addEventListener('click', run);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') run();
  });
  fillExamples();
</script>
